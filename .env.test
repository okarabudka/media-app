# Test-only values; the test suite never talks to TMDB or Redis.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
TMDB_API_KEY=test-tmdb-token
AUTH_USERNAME=demo
AUTH_PASSWORD=test-password
# tests/bootstrap.php generates this key pair on the first run.
JWT_SECRET_KEY=%kernel.project_dir%/var/test-jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/test-jwt/public.pem
JWT_PASSPHRASE=test-only-passphrase
