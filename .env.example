# Copy to .env and fill in the empty values. `make up` does the copy and generates APP_SECRET and JWT_PASSPHRASE.
# .env is git-ignored: never commit real secrets. Docker Compose reads the port settings from the same file.

###> docker compose ###
APP_PORT=8080
VITE_PORT=5173
# Host port of the production-like stack (compose.prod.yaml).
PROD_PORT=8081
###< docker compose ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> tmdb ###
# TMDB API Read Access Token (the v4 bearer token), from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Seconds a TMDB response stays in the Redis cache.
TMDB_CACHE_TTL=600
# Only change for a stand-in TMDB (for example a local fixture server).
TMDB_BASE_URI=https://api.themoviedb.org/3/
# 1 serves fictional sample data from fixtures/demo/ instead of TMDB (no token needed). `make demo` sets it.
TMDB_DEMO=0
###< tmdb ###

###> stub login ###
# The single account the stub auth provider accepts. While either value is empty, every login is rejected.
AUTH_USERNAME=
AUTH_PASSWORD=
###< stub login ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
# 1 forces the Secure flag on the auth cookie; it is set automatically for HTTPS requests anyway.
JWT_COOKIE_SECURE=0
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###
